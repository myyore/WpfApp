<Window x:Class="WpfApp.PdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图纸查看" Width="700" Height="900"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="Manual" 
        Background="#2D2D30">

    <Grid>
        <Border x:Name="ViewHost" Background="White" ClipToBounds="True"
                Width="595" Height="842" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseWheel="ViewHost_MouseWheel"
                MouseLeftButtonDown="ViewHost_MouseLeftButtonDown"
                MouseLeftButtonUp="ViewHost_MouseLeftButtonUp"
                MouseMove="ViewHost_MouseMove"
                MouseRightButtonDown="ViewHost_MouseRightButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>

            <Grid ClipToBounds="True" Background="White">
                <Image x:Name="PageImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                            <RotateTransform x:Name="ImageRotate" Angle="0"/>
                            <TranslateTransform x:Name="ImageTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <TextBlock x:Name="HintText" Text="正在加载图纸…" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Foreground="Red" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Button x:Name="ToggleOrientationBtn" 
                Width="40" Height="40" 
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="15,15,15,0"
                Background="#80000000" 
                BorderThickness="0" 
                Cursor="Hand" 
                Click="ToggleOrientationBtn_Click"
                ToolTip="切换横向/纵向">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <Path x:Name="OrientationIcon" 
                              Data="M 2,4 L 6,4 L 6,12 L 2,12 Z M 10,2 L 14,2 L 14,10 L 10,10 Z M 8,14 A 6,6 0 1 1 8,2 A 6,6 0 1 1 8,14" 
                              Stroke="White" StrokeThickness="1.5" 
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="14"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#CC000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>