<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="WpfApp.MainWindow"
        Title="图纸查询" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.ico"
        Background="#F3F3F3" Width="330" Height="520" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid Margin="12" Panel.ZIndex="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="6" Height="34">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="8" ShadowDepth="1" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SearchScopeTag" Grid.Column="0" Margin="6,4,0,4" Background="#E3F2FD" CornerRadius="4" Padding="6,0" Visibility="Collapsed" MouseLeftButtonDown="SearchScopeTag_MouseLeftButtonDown">
                        <TextBlock x:Name="SearchScopeText" Text="节点" Foreground="#1976D2" FontSize="11" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="6,0" FontSize="12" TextChanged="TxtSearch_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="输入零件号或参数搜索..." Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Height="50"/>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="1" Direction="270"/>
                </Border.Effect>

                <ListBox x:Name="SearchResultList" BorderThickness="0" Background="Transparent" Padding="6"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" CornerRadius="4" Padding="8,6">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制图纸名称" Click="CopyName_Click" />
                                        <MenuItem Header="复制代号" Click="CopyPartNo_Click" />
                                        <MenuItem Header="复制全部参数" Click="CopyDetails_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <!-- 零件号（实时高亮） -->
                                        <TextBlock FontWeight="Bold" FontSize="13" Foreground="#333" TextWrapping="Wrap"
                                                   local:HighlightBehavior.Text="{Binding Name}"
                                                   local:HighlightBehavior.HighlightText="{Binding SearchText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

                                        <!-- 【核心修改】结构化参数展示 -->
                                        <ItemsControl ItemsSource="{Binding Details}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <!-- 使用 WrapPanel 实现自动换行 -->
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 遍历每一个键值对，生成类似小标签的排版 -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                        <!-- 参数名（加粗） -->
                                                        <TextBlock FontSize="11" Foreground="#333" FontWeight="Bold" Text="{Binding Key}"/>
                                                        <TextBlock FontSize="11" Foreground="#666" Text=": "/>
                                                        <!-- 参数值（支持高亮） -->
                                                        <TextBlock FontSize="11" Foreground="#666"
                                                                   local:HighlightBehavior.Text="{Binding Value}"
                                                                   local:HighlightBehavior.HighlightText="{Binding SearchText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Button Grid.Column="1" Tag="{Binding}" Click="OpenPdfBtn_Click"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="查看图纸" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="#F0F4F9" CornerRadius="4" Padding="6">
                                                    <Path Data="M 0,2 L 12,2 L 15,5 L 15,14 L 0,14 Z M 2,5 L 13,5 M 2,8 L 13,8 M 2,11 L 9,11" 
                                                          Stroke="#2F80ED" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform" Width="14" Height="14"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Border x:Name="OverlayLayer" Background="Transparent" Visibility="Collapsed" Panel.ZIndex="1" MouseLeftButtonDown="OverlayLayer_MouseLeftButtonDown"/>

        <Border x:Name="DrawerPanel" Width="190" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Margin="0,48,0,0" Background="White" CornerRadius="0,12,12,0" Panel.ZIndex="3">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="12" Direction="0" ShadowDepth="2"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTransform" X="-190"/>
            </Border.RenderTransform>

            <ListBox x:Name="FlatDirectoryList" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="FlatDirectoryList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="8,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,8">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem Content="外摩擦片"/>
                <ListBoxItem Content="内对偶片"/>
                <ListBoxItem Content="内摩擦片"/>
                <ListBoxItem Content="外对偶片"/>
                <ListBoxItem Content="仅有PDF文件"/>
            </ListBox>
        </Border>

        <Button x:Name="HamburgerBtn" Width="32" Height="32" Background="Transparent" BorderThickness="0" 
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,48,0,0" Cursor="Hand" Click="HamburgerBtn_Click" Panel.ZIndex="4">
            <Path Data="M 0,0 H 16 M 0,5 H 16 M 0,10 H 16" Stroke="#333" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Button>
    </Grid>
</Window>